+def test_fixture_closure_order_independence_with_parametrize(pytester: Pytester) -> None:
+    """Fixture closure must not depend on unrelated earlier collection (#14635)."""
+    root = pytester.path
+    tests = root / "tests"
+    tests.mkdir()
+    components = tests / "components"
+    components.mkdir()
+    components.joinpath("conftest.py").write_text(
+        "import pytest\n@pytest.fixture\ndef cache_dir_side_effect(): return None\n"
+        "@pytest.fixture\ndef mock_init_cache_dir(cache_dir_side_effect): return cache_dir_side_effect\n",
+        encoding="utf-8",
+    )
+    unrelated = components / "unrelated"
+    unrelated.mkdir()
+    unrelated.joinpath("test_unrelated.py").write_text("def test_unrelated(): pass\n", encoding="utf-8")
+    target = components / "target"
+    target.mkdir()
+    target.joinpath("test_target.py").write_text(
+        "import pytest\n@pytest.mark.parametrize('cache_dir_side_effect', ['x'])\n"
+        "def test_target(mock_init_cache_dir): assert mock_init_cache_dir == 'x'\n",
+        encoding="utf-8",
+    )
+    result = pytester.runpytest("--collect-only", str(unrelated), str(target / "test_target.py"))
+    result.stdout.fnmatch_lines(["*test_target*"])
+    assert result.ret == ExitCode.OK
+
+
